.hud-root {
    width: 100%;
    height: 100%;
    padding: 12px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 12px;
}

.resource-panel {
    flex-direction: row;
    gap: 16px;
}

.resource-label {
    font-size: 18px;
    color: white;
}

.build-panel, .selection-panel, .notification-panel {
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 6px;
    flex-direction: column;
    gap: 8px;
}

.build-button, .action-button {
    height: 32px;
}

.notification-label {
    color: #ffce54;
    min-height: 20px;
}

.panel-title {
    font-weight: bold;
    color: white;
}

.selection-label {
    color: white;
}
